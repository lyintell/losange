# EAS Build upload — based on .gitignore + mobile-only exclusions.
# See https://docs.expo.dev/build-reference/easignore/

# dependencies
node_modules/

# Expo
.expo/
.expo-shared/
dist/
dist-*/
web-build/
expo-env.d.ts

# EAS / builds locaux
.eas/
build/
credentials.json
*.apk
*.aab
*.ipa
*.tar.gz

# Native (prebuild / signing)
.kotlin/
/ios
/android
local.properties
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.hprof
google-services.json
GoogleService-Info.plist
service-account*.json
firebase-adminsdk*.json

# Metro
.metro-health-check*

# debug & logs
npm-debug.*
yarn-debug.*
yarn-error.*
*.log
*.trace
*.tmp
*.temp

# macOS
.DS_Store
*.pem

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Environment & secrets
.env
.env.*
!.env.example
expo.dev
supabase/.env
supabase/functions/.env

# TypeScript
*.tsbuildinfo

# Supabase CLI (local dev)
.supabase/
supabase/.temp/
supabase/.branches/

# SQLite (copies locales / exports)
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal
*.db-journal

# IDE / editor
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo
*~

# Cursor / Claude
.cursor/
.claude/

# Test & coverage
coverage/
.turbo/

# Next.js / Vercel artifacts (any path)
.next/
out/
.vercel/
next-env.d.ts

# --- Not required for Expo Android/iOS build ---

# Next.js admin webapp (~800 MB with node_modules + .next)
webapps/

# Dev prompts & docs
prompts/

# Supabase (migrations/functions deployed separately)
supabase/

# Deploy / build helper scripts
scripts/

# Repo metadata
.git/

# Docs not used at runtime
AGENTS.md
CLAUDE.md
.cursorrules
